DB_PASSWORD=__CHANGE_ME_DB_PASSWORD__
DATA_ROOT=/data/hamster-analysis
CERT_ROOT=/etc/hamster-analysis/certs
SSL_CERT_FILE=kyyin.xyz.pem
SSL_KEY_FILE=kyyin.xyz.key
APP_STORAGE_ROOT=/app/data_storage
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=__CHANGE_ME_ADMIN_PASSWORD__
AUTH_REQUIRE_EMAIL_VERIFICATION=0
EMAIL_DELIVERY_MODE=disabled
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_LABEL=AutoTFL
AUTH_DEV_SHOW_EMAIL_CODE=0
AUTH_EMAIL_VERIFICATION_EXPIRE_MINUTES=30
AUTH_PASSWORD_RESET_EXPIRE_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=try
