# 复制为 .env 后按需修改：cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，请勿将真实密码提交到仓库。

# Docker BuildKit 构建参数
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
BUILDKIT_PROGRESS=plain

# PostgreSQL 连接参数（docker-compose.local.yml 通过 env_file 注入）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=autotfl
POSTGRES_USER=autotfl_user
POSTGRES_PASSWORD=ChangeMe123!

# 管理员账号（首次启动自动初始化）
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=admin123

# 认证与邮箱（本地联调）
AUTH_REQUIRE_EMAIL_VERIFICATION=0
EMAIL_DELIVERY_MODE=console
EMAIL_FROM_ADDRESS=autotfl@test.local
EMAIL_FROM_LABEL=AutoTFL Test
AUTH_DEV_SHOW_EMAIL_CODE=1
AUTH_EMAIL_VERIFICATION_EXPIRE_MINUTES=30
AUTH_PASSWORD_RESET_EXPIRE_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=try
